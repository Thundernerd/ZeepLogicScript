<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>TNRD.Zeepkist.LogicScripting.Tests</RootNamespace>
    <!-- The mod, its in-game tests and ZeepSDK target .NET Framework; the code under test runs on .NET too -->
    <NoWarn>$(NoWarn);NU1701;NU1702</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The mod only compiles against these; the tests need them at runtime too -->
    <PackageReference Include="BepInEx.BaseLib" Version="5.4.20" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="ZeepSDK" Version="$(ZeepSdkVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zeepkist.LogicScripting\Zeepkist.LogicScripting.csproj" />
    <!-- Only its scenario parser and step list run here, which don't touch the game -->
    <ProjectReference Include="..\Zeepkist.LogicScripting.InGameTests\Zeepkist.LogicScripting.InGameTests.csproj" />
  </ItemGroup>

</Project>
